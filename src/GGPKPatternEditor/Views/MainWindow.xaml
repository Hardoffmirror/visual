<Window x:Class="GGPKPatternEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GGPKPatternEditor.ViewModels"
        xmlns:models="clr-namespace:GGPKPatternEditor.Models"
        Title="GGPK Pattern Editor"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open GGPK" Command="{Binding OpenGGPKFileCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>

                <Button Content="Load Config" Command="{Binding LoadConfigurationCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="Save Config" Command="{Binding SaveConfigurationCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        IsEnabled="{Binding HasConfiguration}"/>
                <Button Content="New Config" Command="{Binding CreateDefaultConfigurationCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>

                <Button Content="Search Patterns" Command="{Binding SearchPatternsCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Background="#4CAF50"
                        IsEnabled="{Binding IsFileLoaded}"/>
                <Button Content="Apply All" Command="{Binding ApplyAllReplacementsCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Background="#FF5722"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - File Browser & Rules -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File Browser -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="4" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Files" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                        <TextBox Grid.Row="1"
                                 Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Filter files..." Foreground="Gray" Margin="5,2"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TreeView Grid.Row="2"
                                  ItemsSource="{Binding FileTree}"
                                  SelectedItemChanged="TreeView_SelectedItemChanged"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:TreeNode}"
                                                         ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Margin="2,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- Pattern Rules -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="4" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Pattern Rules" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding CurrentConfiguration.Rules}"
                                 SelectedItem="{Binding SelectedRule}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Right Panel - Content & Results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- File Content Viewer -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="4" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="File Content" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <Button Content="Export" Command="{Binding ExportFileCommand}"
                                    Margin="16,0,8,0" Padding="8,4"/>
                            <Button Content="Export CSV" Command="{Binding ExportToCsvCommand}"
                                    Margin="0,0,8,0" Padding="8,4"
                                    Visibility="{Binding IsDatFile, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Content="Edit" Command="{Binding StartEditingCommand}"
                                    Margin="0,0,8,0" Padding="8,4"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <Button Content="Save" Command="{Binding SaveFileChangesCommand}"
                                    Margin="0,0,4,0" Padding="8,4" Background="#4CAF50" Foreground="White"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Content="Cancel" Command="{Binding CancelEditingCommand}"
                                    Padding="8,4"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- DAT Table View -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DatTableView}"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  FontFamily="Consolas"
                                  FontSize="11"
                                  Visibility="{Binding IsDatFile, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"/>

                        <!-- Text View (read-only) -->
                        <TextBox Grid.Row="1"
                                 Text="{Binding FileContent, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDatFile}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Editable Text View -->
                        <TextBox Grid.Row="1"
                                 Text="{Binding EditableContent, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- GridSplitter -->
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                              Background="Transparent"/>

                <!-- Search Results -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="4" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Search Results" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SearchResults}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*"/>
                                <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="150"/>
                                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="80"/>
                                <DataGridTextColumn Header="Match" Binding="{Binding MatchedText}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>

                <ProgressBar Grid.Column="1" Value="{Binding ProgressValue}"
                             Maximum="100" Height="16" Margin="8,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
